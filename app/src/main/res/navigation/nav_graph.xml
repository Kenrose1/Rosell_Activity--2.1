<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/questionsFragment">

    <fragment
        android:id="@+id/questionsFragment"
        android:name="com.example.rosell_labactivity_21.QuestionsFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_questions">
        <action
            android:id="@+id/action_questionsFragment_to_multipleChoiceFragment"
            app:destination="@id/multipleChoiceFragment" />
    </fragment>

    <fragment
        android:id="@+id/multipleChoiceFragment"
        android:name="com.example.rosell_labactivity_21.MultipleChoiceFragment"
        android:label="Question"
        tools:layout="@layout/fragment_multiple_choice">
        <argument
            android:name="questionType"
            app:argType="integer" />
        <action
            android:id="@+id/action_multipleChoiceFragment_to_answersFragment"
            app:destination="@id/answersFragment" />
    </fragment>

    <fragment
        android:id="@+id/answersFragment"
        android:name="com.example.rosell_labactivity_21.AnswersFragment"
        android:label="Result"
        tools:layout="@layout/fragment_answers">
        <argument
            android:name="isCorrect"
            app:argType="boolean" />
        <argument
            android:name="explanation"
            app:argType="string" />
        <action
            android:id="@+id/action_answersFragment_to_questionsFragment"
            app:destination="@id/questionsFragment"
            app:popUpTo="@id/questionsFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
