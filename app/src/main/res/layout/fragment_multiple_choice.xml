<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvQuestionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="110dp"
            android:layout_marginBottom="32dp"
            android:text="Question Title"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMercury"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_mercury"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnVenus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_venus"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnEarth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_earth"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnMars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_mars"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnJupiter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_jupiter"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnSaturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_saturn"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnUranus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_uranus"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnNeptune"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planet_neptune"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_questions"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
